# Local development defaults to SQLite. For cloud PostgreSQL, replace DATABASE_URL.
DATABASE_URL=sqlite:///./pikr.db
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis-Immediately-123!

# Cloudflare R2 (buat bucket private, bukan public)
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=ISI_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=ISI_SECRET_ACCESS_KEY
R2_BUCKET_NAME=widya-trapsila-files
